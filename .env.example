PORT=3000
NODE_ENV=development

# ==========================================
# CƠ SỞ DỮ LIỆU (TimescaleDB)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=LocalSecretPass!23
DB_NAME=shrimp_local_db

# ==========================================
# MESSAGE BROKERS (Giao tiếp mảng IoT & Microservices)
# ==========================================
# Mosquitto (Topic: telemetry) - Giao tiếp với ESP32
MQTT_BROKER_URL=mqtt://localhost:1883

# RabbitMQ (Topic: shrimp.events) - Truyền tải Event/Alert nội bộ
RABBITMQ_URL=amqp://admin:admin123@localhost:5672

# ==========================================
# IDENTITY SERVICE (Xác thực người dùng)
# ==========================================
JWT_SECRET=shrimp_core_secret_key_2026
JWT_EXPIRATION=7d
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# EXTERNAL & AI SERVICES (Tích hợp ngoại vi)
# ==========================================
# AI Prediction Service (Dự báo rủi ro)
AI_PREDICTION_API_URL=http://localhost:8000/api/predict

# Firebase Cloud Messaging (Notification Service)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="your-firebase-private-key"

# ==========================================
# IN-MEMORY DATA STORE (Redis - Cache & Rate Limiting)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==========================================
# CẤU HÌNH GỬI EMAIL (Gmail SMTP)
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
