# ==========================================
# CẤU HÌNH CHUNG
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# CƠ SỞ DỮ LIỆU (TimescaleDB)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=aquasense

# ==========================================
# MESSAGE BROKERS (Giao tiếp mảng IoT & Microservices)
# ==========================================
# Mosquitto (Topic: telemetry) - Giao tiếp với ESP32
MQTT_BROKER_URL=mqtt://localhost:1883

# RabbitMQ (Topic: shrimp.events) - Truyền tải Event/Alert nội bộ
RABBITMQ_URL=amqp://admin:admin123@localhost:5672

# ==========================================
# IDENTITY SERVICE (Xác thực người dùng)
# ==========================================
JWT_SECRET=shrimp_core_secret_key_2026
JWT_EXPIRATION=7d

# ==========================================
# EXTERNAL & AI SERVICES (Tích hợp ngoại vi)
# ==========================================
# AI Prediction Service (Dự báo rủi ro)
AI_PREDICTION_API_URL=http://localhost:8000/api/predict

# Firebase Cloud Messaging (Notification Service)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="your-firebase-private-key"