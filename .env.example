# ==========================================
# CẤU HÌNH CHUNG
# ==========================================
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Cho phép in OTP ở console trong môi trường local/test; không bật ở production.
AUTH_OTP_CONSOLE_FALLBACK=false

# ==========================================
# CƠ SỞ DỮ LIỆU (TimescaleDB)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_database_password
DB_NAME=shrimp_local_db
DB_SYNCHRONIZE=false

# ==========================================
# MESSAGE BROKERS (Giao tiếp mảng IoT & Microservices)
# ==========================================
# Mosquitto (Topic: telemetry) - Giao tiếp với ESP32
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TOPIC=telemetry/devices/+/data
MQTT_USER=your_mqtt_username
MQTT_PASS=your_mqtt_password

# RabbitMQ (Topic: shrimp.events) - Truyền tải Event/Alert nội bộ
RABBITMQ_URL=amqp://your_rabbitmq_user:your_rabbitmq_password@localhost:5672
# Disabled by default. Enable only after AI risk policy approval and after the
# ai-risk publisher supplies a unique event_id for every event.
AI_RISK_ALERTS_CONSUMER_ENABLED=false
AI_RISK_ALERTS_EXCHANGE=shrimp.events
AI_RISK_ALERTS_QUEUE=ai_risk_alerts
AI_RISK_ALERTS_DLQ=ai_risk_alerts.dlq
AI_RISK_ALERTS_PREFETCH=10
AI_RISK_ALERTS_MAX_RETRIES=3
AI_RISK_ALERTS_MAX_AGE_MINUTES=15
AI_RISK_ALERTS_CONNECT_TIMEOUT_MS=5000
AI_RISK_ALERTS_CONNECT_TIMEOUT_MS=5000
AI_PRODUCTION_INFERENCE_APPROVED=false
# Disabled by default. Enable only after AI risk policy approval and after the
# ai-risk publisher supplies a unique event_id for every event.
AI_RISK_ALERTS_CONSUMER_ENABLED=false
AI_RISK_ALERTS_EXCHANGE=shrimp.events
AI_RISK_ALERTS_QUEUE=ai_risk_alerts
AI_RISK_ALERTS_DLQ=ai_risk_alerts.dlq
AI_RISK_ALERTS_PREFETCH=10
AI_RISK_ALERTS_MAX_RETRIES=3
AI_RISK_ALERTS_MAX_AGE_MINUTES=15
AI_PRODUCTION_INFERENCE_APPROVED=false

# ==========================================
# IDENTITY SERVICE (Xác thực người dùng Dual-Token JWT)
# ==========================================
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# IN-MEMORY DATA STORE (Redis - Cache & Rate Limiting)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==========================================
# CẤU HÌNH GỬI EMAIL (Gmail SMTP)
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_TIMEOUT_MS=10000
# Giá trị hợp lệ: smtp | mock. `mock` chỉ được phép khi NODE_ENV=development/test.
EMAIL_MODE=smtp

# ==========================================
# EXTERNAL & AI SERVICES (Tích hợp ngoại vi)
# ==========================================
# AI Prediction Service (Dự báo rủi ro)
AI_PREDICTION_API_URL=http://localhost:8000/api/predict

# Thiết bị quá hạn phản hồi (phút)
DEVICE_STALE_TIMEOUT_MINUTES=15 

# Firebase Cloud Messaging (Notification Service)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="your-firebase-private-key"

# ==========================================
# SMS OTP (eSMS Gateway)
# ==========================================
# Giá trị hợp lệ: esms | mock. `mock` chỉ được phép khi NODE_ENV=development/test.
SMS_MODE="esms"
ESMS_API_KEY="your-esms-api-key"
ESMS_SECRET_KEY="your-esms-secret-key"
ESMS_BRANDNAME="Baotrixemay"
ESMS_SMS_TYPE="2"
ESMS_CONTENT_TEMPLATE="{OTP} la ma xac minh dang ky {BRANDNAME} cua ban"
ESMS_TIMEOUT_MS=10000
